{
  "name": "@temporalio/core-bridge",
  "version": "1.24.0",
  "description": "Temporal.io SDK Core<>Node bridge",
  "main": "index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build-rust": "tsx ./scripts/build.ts --force",
    "build": "pnpm run build-rust",
    "build-rust-release": "pnpm run build-rust --release",
    "format": "cargo fmt",
    "lint": "cargo clippy --fix --allow-staged",
    "lint:check": "cargo clippy",
    "test": "tsx ../../scripts/ava-ci.ts ./lib/__tests__/test-*.js"
  },
  "ava": {
    "timeout": "60s",
    "concurrency": 1,
    "workerThreads": false
  },
  "keywords": [
    "temporal",
    "workflow",
    "core",
    "worker"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.13.6",
    "@temporalio/common": "workspace:*"
  },
  "devDependencies": {
    "@grpc/proto-loader": "^0.7.10",
    "arg": "^5.0.2",
    "ava": "^5.3.1",
    "cargo-cp-artifact": "^0.1.9",
    "tsx": "^4.20.6"
  },
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git",
    "directory": "packages/core-bridge"
  },
  "homepage": "https://github.com/temporalio/sdk-typescript/tree/main/packages/core-bridge",
  "engines": {
    "node": ">= 20.3.0"
  },
  "files": [
    "bridge-macros",
    "scripts",
    "src",
    "releases",
    "sdk-core",
    "Cargo.toml",
    "Cargo.lock",
    "index.js",
    "common.js",
    "index.d.ts",
    "ts",
    "lib",
    "!ts/__tests__",
    "!lib/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  }
}
