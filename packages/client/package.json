{
  "name": "@temporalio/client",
  "version": "1.24.0",
  "description": "Temporal.io SDK Client sub-package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "tsx ../../scripts/ava-ci.ts ./lib/__tests__/test-*.js"
  },
  "ava": {
    "timeout": "60s",
    "concurrency": 1,
    "workerThreads": false
  },
  "keywords": [
    "temporal",
    "workflow",
    "client"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.13.6",
    "@temporalio/common": "workspace:*",
    "@temporalio/proto": "workspace:*",
    "nexus-rpc": "^0.0.3",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/temporalio/sdk-typescript/tree/main/packages/client",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__"
  ],
  "engines": {
    "node": ">= 20.3.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    },
    "./internal/pkg": {
      "types": "./lib/pkg.d.ts",
      "default": "./lib/pkg.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "internal": [
        "lib/internal.d.ts"
      ],
      "internal/pkg": [
        "lib/pkg.d.ts"
      ]
    }
  }
}
