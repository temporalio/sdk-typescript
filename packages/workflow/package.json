{
  "name": "@temporalio/workflow",
  "version": "1.24.0",
  "description": "Temporal.io SDK Workflow sub-package",
  "keywords": [
    "temporal",
    "workflow",
    "isolate"
  ],
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git",
    "directory": "packages/workflow"
  },
  "homepage": "https://github.com/temporalio/sdk-typescript/tree/main/packages/workflow",
  "license": "MIT",
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "internal": [
        "lib/internal.d.ts"
      ],
      "internal/global-overrides": [
        "lib/global-overrides.d.ts"
      ],
      "internal/logs": [
        "lib/logs.d.ts"
      ],
      "internal/nexus/system/generated/registry": [
        "lib/nexus/system/generated/registry.d.ts"
      ],
      "internal/worker-interface": [
        "lib/worker-interface.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    },
    "./internal/global-overrides": {
      "types": "./lib/global-overrides.d.ts",
      "default": "./lib/global-overrides.js"
    },
    "./internal/logs": {
      "types": "./lib/logs.d.ts",
      "default": "./lib/logs.js"
    },
    "./internal/nexus/system/generated/registry": {
      "types": "./lib/nexus/system/generated/registry.d.ts",
      "default": "./lib/nexus/system/generated/registry.js"
    },
    "./internal/worker-interface": {
      "types": "./lib/worker-interface.d.ts",
      "default": "./lib/worker-interface.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "gen:system-nexus": "tsx ./scripts/gen-system-nexus.ts",
    "test": "tsx ../../scripts/ava-ci.ts ./lib/__tests__/test-*.js"
  },
  "ava": {
    "timeout": "60s",
    "concurrency": 1,
    "workerThreads": false
  },
  "dependencies": {
    "@temporalio/common": "workspace:*",
    "@temporalio/proto": "workspace:*",
    "nexus-rpc": "^0.0.3"
  },
  "devDependencies": {
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "source-map": "^0.7.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.3.0"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__"
  ]
}
