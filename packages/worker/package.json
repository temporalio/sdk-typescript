{
  "name": "@temporalio/worker",
  "version": "1.26.0",
  "description": "Temporal.io SDK Worker sub-package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "keywords": [
    "temporal",
    "workflow",
    "worker",
    "isolate"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "preferUnplugged": true,
  "scripts": {
    "build": "pnpm run build:rust && pnpm run build:ts",
    "build:rust": "node scripts/build-workflow-plugin.mts",
    "build:ts": "tsc --build",
    "build:workflow-plugin": "pnpm run build:rust",
    "format": "cd activity-reference-plugin && cargo fmt",
    "lint": "cd activity-reference-plugin && cargo clippy --fix --allow-staged --target wasm32-wasip1 --target-dir target",
    "lint:check": "cd activity-reference-plugin && cargo fmt -- --check && cargo clippy --locked --target wasm32-wasip1 --target-dir target -- -D warnings",
    "test": "tsx ../../scripts/ava-ci.ts ./lib/__tests__/test-*.js"
  },
  "ava": {
    "timeout": "60s",
    "concurrency": 1,
    "workerThreads": false
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.6",
    "@swc/core": "1.16.21",
    "@temporalio/activity": "workspace:*",
    "@temporalio/client": "workspace:*",
    "@temporalio/common": "workspace:*",
    "@temporalio/core-bridge": "workspace:*",
    "@temporalio/nexus": "workspace:*",
    "@temporalio/proto": "workspace:*",
    "@temporalio/workflow": "workspace:*",
    "heap-js": "^2.6.0",
    "memfs": "^4.6.0",
    "nexus-rpc": "^0.0.3",
    "rxjs": "^7.8.1",
    "source-map": "^0.7.4",
    "source-map-loader": "^5.0.0",
    "supports-color": "^8.1.1",
    "unionfs": "^4.6.0",
    "webpack": "^5.108.4"
  },
  "peerDependencies": {
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "@types/supports-color": "^8.1.3",
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git",
    "directory": "packages/worker"
  },
  "homepage": "https://github.com/temporalio/sdk-typescript/tree/main/packages/worker",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__"
  ],
  "engines": {
    "node": ">= 20.3.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    },
    "./internal/pkg": {
      "types": "./lib/pkg.d.ts",
      "default": "./lib/pkg.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "internal": [
        "lib/internal.d.ts"
      ],
      "internal/pkg": [
        "lib/pkg.d.ts"
      ]
    }
  }
}
