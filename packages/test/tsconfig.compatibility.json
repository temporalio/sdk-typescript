{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"]
}
