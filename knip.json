{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-lintignore"
  ],
  "ignoreIssues": {
    "packages/workflow/src/nexus/system/generated/**": [
      "exports",
      "types"
    ]
  },
  "workspaces": {
    "scripts": {
      "entry": [
        "*.ts",
        "fixtures/*.mjs"
      ],
      "project": [
        "**/*.ts",
        "fixtures/*.mjs"
      ]
    },
    "packages/test": {
      "entry": [
        "src/test-*.ts",
        "src/helpers.ts",
        "src/mocks/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
