{
  "$schema": "./node_modules/knip/schema.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "packages/workflow/src/nexus/system/generated/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": ["knip.entrypoints.ts"]
    },
    "scripts": {
      "entry": ["*.ts"],
      "project": ["**/*.ts"],
      "includeEntryExports": false
    },
    "packages/test": {
      "entry": ["src/test-*.ts", "src/helpers.ts", "src/mocks/**/*.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    }
  }
}
