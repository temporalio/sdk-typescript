{
  "name": "typescript-sdk",
  "private": true,
  "keywords": [
    "temporal",
    "workflow",
    "isolate"
  ],
  "homepage": "https://github.com/temporalio/sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git"
  },
  "license": "MIT",
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "directories": {
    "doc": "docs"
  },
  "files": [],
  "scripts": {
    "update-core": "tsx scripts/update-core.ts",
    "changelog:check": "tsx scripts/changelog.ts check",
    "changelog:prepare": "tsx scripts/changelog.ts prepare",
    "release:notes": "tsx scripts/changelog.ts release-notes --submodule packages/core-bridge/sdk-core",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:test": "node --import tsx --test scripts/prepare-release.test.ts",
    "rebuild": "pnpm run clean && pnpm run build",
    "build": "pnpm --recursive --stream run build",
    "build:watch": "pnpm run gen && tsc --build --watch packages/*/tsconfig.json",
    "gen": "pnpm run gen:protos && pnpm run gen:payload-visitor",
    "gen:protos": "tsx ./packages/proto/scripts/compile-proto.ts",
    "gen:payload-visitor": "pnpm --filter @temporalio/proto run gen:payload-visitor",
    "cloud:inventory": "tsx ./scripts/cloud-test-inventory.ts",
    "test": "pnpm --recursive --parallel --workspace-concurrency=1 --stream run test",
    "test:cloud": "tsx ./scripts/run-cloud-tests.ts",
    "test:watch": "pnpm --recursive --stream run test:watch",
    "test:typescript-compatibility": "node node_modules/typescript-compat/bin/tsc -p packages/test/tsconfig.compatibility.json",
    "ci-stress": "node ./packages/test/lib/load/run-all-stress-ci-scenarios.js",
    "ci-nightly": "node ./packages/test/lib/load/run-all-nightly-scenarios.js",
    "lint": "oxlint --fix && oxfmt --write . && pnpm --recursive --stream run lint",
    "lint:check": "oxlint && oxfmt --check . && pnpm --recursive --stream run lint:check",
    "lint:prune": "knip --include exports,types,nsExports,nsTypes",
    "commitlint": "commitlint --from origin/main",
    "format": "oxfmt --write . && pnpm --recursive --stream run format",
    "clean": "tsx ./scripts/clean.ts",
    "docs": "cd packages/docs && pnpm run maybe-install-deps-and-build-docs",
    "ava": "pnpm -C packages/test exec ava"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.39",
    "arg": "^5.0.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "fs-extra": "^11.2.0",
    "json5": "^2.2.3",
    "knip": "6.40.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-compat": "npm:typescript@5.7.3",
    "verdaccio": "^6.5.0"
  },
  "engines": {
    "node": ">= 20.3.0",
    "pnpm": ">= 10.27.0",
    "rustc": ">= 1.53.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.27.0",
      "onFail": "warn"
    }
  }
}
